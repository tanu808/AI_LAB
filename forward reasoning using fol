# FORWARD CHAINING EXAMPLE
# Problem: The given rules cannot prove "john likes peanuts"
# Analysis at the end shows why

class Rule:
    def __init__(self, premises, conclusion):
        self.premises = premises
        self.conclusion = conclusion
    
    def __str__(self):
        return f"{' & '.join(self.premises)} ⇒ {self.conclusion}"

def forward_chaining(kb, rules, goal):
    """Forward chaining algorithm"""
    print(f"Initial KB: {kb}")
    print(f"Goal: {goal}")
    print("-" * 60)
    
    iteration = 0
    while True:
        iteration += 1
        print(f"\nIteration {iteration}:")
        new_facts = set()
        
        for rule in rules:
            print(f"\n  Checking: {rule}")
            
            # Check if all premises are satisfied
            if all(p in kb for p in rule.premises):
                print(f"  ✓ All premises satisfied")
                
                if rule.conclusion not in kb:
                    print(f"  → Deriving new fact: {rule.conclusion}")
                    new_facts.add(rule.conclusion)
                    
                    if rule.conclusion == goal:
                        kb.add(rule.conclusion)
                        print("\n" + "=" * 60)
                        print(f"✓ GOAL PROVEN: {goal}")
                        return True
                else:
                    print(f"  → Conclusion already known")
        
        if not new_facts:
            print("\n" + "=" * 60)
            print("✗ GOAL CANNOT BE PROVEN")
            print("No new facts can be derived")
            return False
        
        kb.update(new_facts)
        print(f"\nKB after iteration {iteration}: {sorted(kb)}")

# KNOWLEDGE BASE
KB = {
    "apple is food",
    "vegetables are food",
    "anil eats peanuts",
    "anil is alive"
}

# RULES
rules = [
    # Rule 2: If X eats Y and X is alive, then Y is food
    Rule(["anil eats peanuts", "anil is alive"], "peanuts is food"),
    
    # Rule 4: If anil eats X, then harry eats X
    Rule(["anil eats peanuts"], "harry eats peanuts"),
]

# GOAL
goal = "john likes peanuts"

# RUN
print("FORWARD CHAINING SIMULATION\n")
success = forward_chaining(KB, rules, goal)

# ANALYSIS
print("\n" + "=" * 60)
print("PROBLEM ANALYSIS:")
print("=" * 60)
print("The goal 'john likes peanuts' CANNOT be proven because:")
print("\n1. No rule defines 'likes' relationships")
print("   - The KB has facts about 'eats', but nothing connects eating to liking")
print("\n2. No information about 'john' exists")
print("   - KB mentions 'anil' and 'harry', but not 'john'")
print("\n3. To prove this goal, you would need rules like:")
print("   - Rule: X eats Y ⇒ X likes Y")
print("   - Fact: john eats peanuts")
print("   OR")
print("   - Fact: john is harry (if john=harry)")
print("   - Rule: harry eats peanuts ⇒ john likes peanuts")


